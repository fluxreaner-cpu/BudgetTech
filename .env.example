# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The exact public origin where this app is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://your-budgettech-domain.example"

# ALLOWED_ORIGINS: Optional comma-separated exact origins allowed to embed/use the API.
# Add the exact AI Studio / admin origin only if that integration is required.
ALLOWED_ORIGINS=""

# --- Enterprise AppSec Configuration (OWASP Top 10) ---
# DB_ENCRYPTION_KEY: 256-bit Hex string (64 hex characters) used for AES-256-GCM database field encryption at rest.
# Required in production. Generate a unique 32-byte random key and keep it stable; never commit it.
DB_ENCRYPTION_KEY=""

# SESSION_SECRET: Required in production; generate a unique high-entropy secret. Never reuse this example file value.
SESSION_SECRET=""

# NODE_ENV: Set to 'production' in live deployments for strict HTTPS, HSTS, and secure cookie enforcement.
NODE_ENV="production"

# PORT: Web server listening port (Default: 3000)
PORT="3000"

# --- SMTP Transactional Email Configuration (Optional for Live Production Email Verification) ---
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="security@budgettech.cyber"
SMTP_PASS="secure_smtp_password"
SMTP_FROM="\"BudgetTech Security\" <no-reply@budgettech.cyber>"

